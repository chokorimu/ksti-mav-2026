[Unit]
Description=KSTI MAV autonomous robot
After=dev-ttyACM0.device
Wants=dev-ttyACM0.device
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/ksti-mav-2026
ExecStart=%h/ksti-mav-2026/scripts/run.sh prototype
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
